# Database
DATABASE_URL=sqlite:///./trendpulse.db

# Alpaca API (Market Data)
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here

# Optional: Upstox API
UPSTOX_API_KEY=your_upstox_api_key_here
UPSTOX_API_SECRET=your_upstox_secret_key_here

# Social Harvester (Apify / Reddit / PyTrends)
APIFY_API_TOKEN=your_apify_api_token_here
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here

# App settings
API_KEY=your_secure_api_key_here
STRICT_REAL_DATA=true
ALLOW_SIMULATED_DATA=false
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here
NEWS_API_KEY=your_news_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_CSE_ID=your_google_cse_id_here
